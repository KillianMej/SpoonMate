<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<GridPane prefHeight="1080.0" prefWidth="1920.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.exemple.spoonmate.ManageTablesController">
   <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints fillHeight="false" maxHeight="1112.0" minHeight="10.0" prefHeight="960.4" valignment="CENTER" vgrow="SOMETIMES" />
   </rowConstraints>
   <children>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="233.0" prefWidth="546.0" spacing="20.0" GridPane.halignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label text="Libérer une table">
               <font>
                  <Font size="44.0" />
               </font>
               <style>
                  -fx-font-weight: bold;
                  -fx-text-fill: #34495e;
               </style>
            </Label>
            <TextField fx:id="freeTableId" onAction="#freeTableSubmit" prefHeight="25.0" prefWidth="318.0" promptText="Identifiant table" />
            <HBox alignment="CENTER" spacing="100.0">
               <children>
                  <Button fx:id="freeTableSubmitBtn" mnemonicParsing="false" onAction="#freeTableSubmit" text="Valider" textOverrun="CLIP"
                          style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 6; -fx-padding: 10 20;" />
               </children>
            </HBox>
            <Label fx:id="resultLabel" prefHeight="91.0" prefWidth="441.0">
               <font>
                  <Font size="44.0" />
               </font>
               <style>
                  -fx-text-fill: #e74c3c; /* Text color for results */
               </style>
            </Label>
         </children>
      </VBox>
   </children>
</GridPane>
