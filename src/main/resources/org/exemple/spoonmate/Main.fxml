<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.exemple.spoonmate.MainController">

    <top>
        <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #eeeeee;">
            <Button fx:id="fianances" onAction="#showFinance" text="Finances" />
            <Button fx:id="dashboard" onAction="#showDashboard" text="Dashboard" />
            <Button fx:id="employe" mnemonicParsing="false" onAction="#showEmploye" text="Employe" />
            <Button fx:id="tables" onAction="#showTables" text="Tables" />
            <Button text="Commandes" onAction="#showCommandes"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentArea" />
    </center>

</BorderPane>
