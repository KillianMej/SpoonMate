<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.exemple.spoonmate.MainController">

    <!-- Barre de navigation en haut -->
    <top>
        <HBox spacing="15" style="-fx-padding: 10; -fx-background-color: #2c3e50; -fx-alignment: center;">
            <Button fx:id="fianances" onAction="#showFinance" text="Finances" style="-fx-text-fill: white; -fx-background-color: #2980b9; -fx-padding: 10px 20px; -fx-font-size: 14px; -fx-background-radius: 5px;"/>
            <Button fx:id="dashboard" onAction="#showDashboard" text="Dashboard" style="-fx-text-fill: white; -fx-background-color: #2980b9; -fx-padding: 10px 20px; -fx-font-size: 14px; -fx-background-radius: 5px;"/>
            <Button fx:id="employe" mnemonicParsing="false" onAction="#showEmploye" text="Employe" style="-fx-text-fill: white; -fx-background-color: #2980b9; -fx-padding: 10px 20px; -fx-font-size: 14px; -fx-background-radius: 5px;"/>
            <Button fx:id="tables" onAction="#showTables" text="Tables" style="-fx-text-fill: white; -fx-background-color: #2980b9; -fx-padding: 10px 20px; -fx-font-size: 14px; -fx-background-radius: 5px;"/>
            <Button text="Commandes" onAction="#showCommandes" style="-fx-text-fill: white; -fx-background-color: #2980b9; -fx-padding: 10px 20px; -fx-font-size: 14px; -fx-background-radius: 5px;"/>
        </HBox>
    </top>

    <!-- Zone centrale pour afficher le contenu en fonction des sections sélectionnées -->
    <center>
        <StackPane fx:id="contentArea" />
    </center>

</BorderPane>
