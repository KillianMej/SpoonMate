<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.exemple.spoonmate.MainController">

    <top>
        <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #eeeeee;">
            <Button onAction="#showFinance" text="Finances" />
            <Button onAction="#showDashboard" text="Dashboard" />
            <Button onAction="#showLogin" text="LoginView" />
            <Button onAction="#showRegister" text="RegisterView" />
            <Button mnemonicParsing="false" onAction="#showEmploye" text="Employe" />
            <Button text="Tables" onAction="#showTables"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentArea" />
    </center>

</BorderPane>
