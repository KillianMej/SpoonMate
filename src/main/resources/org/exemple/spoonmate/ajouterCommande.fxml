<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.exemple.spoonmate.AjouterCommandeController"
      spacing="15" alignment="CENTER"
      style="-fx-padding: 30; -fx-background-color: #f4f4f4; -fx-background-radius: 10;">

    <Label text="Nouvelle Commande"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <ComboBox fx:id="platComboBox" promptText="Choisir un plat"
              style="-fx-pref-width: 250; -fx-background-radius: 6; -fx-padding: 8;"/>

    <ComboBox fx:id="tableComboBox" promptText="Choisir une table"
              style="-fx-pref-width: 250; -fx-background-radius: 6; -fx-padding: 8;"/>

    <Button text="Ajouter" onAction="#onAjouter"
            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 6; -fx-padding: 10 20;"/>
</VBox>
