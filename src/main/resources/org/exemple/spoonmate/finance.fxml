<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.exemple.spoonmate.FinanceController"
      spacing="20" alignment="TOP_CENTER">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Tableau de Bord Financier" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <VBox spacing="10">
        <Label fx:id="totalRecetteLabel" text="Total Recettes : 0 €"/>
        <TitledPane text="Détails des Recettes" expanded="false">
            <VBox fx:id="recetteDetailsBox" spacing="5" padding="10"/>
        </TitledPane>
    </VBox>

    <VBox spacing="10">
        <Label fx:id="totalDepenseLabel" text="Total Dépenses : 0 €"/>
        <TitledPane text="Détails des Dépenses" expanded="false">
            <VBox fx:id="depenseDetailsBox" spacing="5" padding="10"/>
        </TitledPane>
    </VBox>

    <Label fx:id="beneficeLabel" text="Bénéfice Total : 0 €" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Button text="Exporter en PDF" onAction="#onExportPdfClick"/>
</VBox>
