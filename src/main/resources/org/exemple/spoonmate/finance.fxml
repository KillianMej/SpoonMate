<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.exemple.spoonmate.FinanceController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label fx:id="totalLabel"/>

    <TitledPane fx:id="recettePane" text="Recettes" expanded="false">
    <ScrollPane fitToWidth="true" prefHeight="150">
        <VBox fx:id="recetteBox" spacing="5">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </VBox>
    </ScrollPane>
</TitledPane>

<TitledPane fx:id="depensePane" text="Dépenses" expanded="false">
    <ScrollPane fitToWidth="true" prefHeight="150">
        <VBox fx:id="depenseBox" spacing="5">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </VBox>
    </ScrollPane>
</TitledPane>

    <Button text="Exporter en PDF" onAction="#onExportPDF"/>
</VBox>
