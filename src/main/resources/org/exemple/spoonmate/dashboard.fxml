<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.exemple.spoonmate.DashboardController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Tableau de Bord Administrateur" style="-fx-font-size: 18px; -fx-font-weight: bold"/>

    <HBox spacing="20">
        <VBox spacing="10" prefWidth="300">
            <Label text="Commandes servies (5 dernières)"/>
            <ListView fx:id="servedOrdersList"/>
        </VBox>

        <VBox spacing="10" prefWidth="300">
            <Label text="Commandes en attente"/>
            <ListView fx:id="pendingOrdersList"/>
        </VBox>
    </HBox>

    <TitledPane text="Statistiques">
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label fx:id="employeeStatsLabel"/>
            <Label fx:id="menuStatsLabel"/>
        </VBox>
    </TitledPane>

    <TitledPane text="Recherche de plats par ingrédient">
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <HBox spacing="10">
                <TextField fx:id="ingredientField" promptText="Entrez un ingrédient"/>
                <Button text="Rechercher" onAction="#onSearch"/>
            </HBox>
            <ListView fx:id="searchResultList"/>
        </VBox>
    </TitledPane>

    <HBox spacing="40">
        <VBox spacing="10">
            <Label text="Factures - clients encore présents"/>
            <Label fx:id="currentClientsTotalLabel"/>
        </VBox>
        <VBox spacing="10">
            <Label text="Factures - clients partis"/>
            <Label fx:id="leftClientsTotalLabel"/>
        </VBox>
    </HBox>
</VBox>
